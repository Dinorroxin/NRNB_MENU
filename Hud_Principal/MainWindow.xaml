<Window
    x:Class="Hud_Principal.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:hud_principal"
    mc:Ignorable="d"
    Title="Núcleo de Riscos Não Biológicos" 
    Height="900" 
    Width="1600"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanMinimize"
    >
    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#e5e7e6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2e2e2e"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3a3a3a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubmenuPanel" TargetType="StackPanel">
            <Setter Property="MaxHeight" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                            Storyboard.TargetProperty="MaxHeight"
                            From="0" To="200"
                            Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>


    <Grid Background="#0d0f0e">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0" 
            Grid.Column="0" 
            Grid.ColumnSpan="2"
            Background="#1a1a1a "
            BorderBrush="#2e2e2e"
            BorderThickness="0,0,0,1"
            Padding="24,0">

            <DockPanel VerticalAlignment="Center">
                <Button
                    x:Name="BtnConfig"
                    DockPanel.Dock="Right"
                    Content="⚙ Configurações"
                    FontSize="13"
                    Padding="12,6"
                    Cursor="Hand"
                    Click="BtnConfig_Click"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#1D9E75" Margin="0,0,10,0"/>
                    <TextBlock Text="NRNB" FontSize="16" FontWeight="Medium" Foreground="#1D9E75"/>
                    <TextBlock Text="  v0.1.0-alpha" FontSize="12" Foreground="#9CA3A0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border
    Grid.Row="1"
    Grid.Column="0"
    Background="#1a1a1a"
    BorderBrush="#2e2e2e"
    BorderThickness="0,0,1,0">

            <DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,12">
                    <TextBlock 
                        Text="Autor" 
                        FontSize="10"
                        Foreground="#6B7280" 
                        TextAlignment="Center"/>
                    <TextBlock 
                        Text="Felipe Siqueira Ramos Galvez" 
                        FontSize="11"
                        Foreground="#9CA3A0" 
                        TextAlignment="Center"
                        TextWrapping="Wrap"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">

                        <TextBlock 
                            Text="Módulos" 
                            FontSize="11"
                            Foreground="#6B7280" 
                            Margin="14,0,0,8"/>

                        <Button 
                            Content="📄  Conversor de arquivos"
                            HorizontalContentAlignment="Left"
                            Padding="14,10" 
                            FontSize="13" 
                            Style="{StaticResource SidebarButton}"/>

                        <!-- Sisagua -->
                        <Button 
                            x:Name="BtnSisagua"
                            HorizontalContentAlignment="Left"
                            Padding="14,10" 
                            FontSize="13" 
                            Style="{StaticResource SidebarButton}"
                            Click="BtnSisagua_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock 
                                    Text="💧  Sisagua" 
                                    VerticalAlignment="Center"/>
                                <TextBlock 
                                    x:Name="SisaguaChevron" 
                                    Text="  ∨"
                                    Foreground="#6B7280" 
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="SisaguaSubmenu" Style="{StaticResource SubmenuPanel}">
                            <Button 
                                Content="    Automação mensal"
                                HorizontalContentAlignment="Left"
                                Padding="14,8" 
                                FontSize="12" 
                                Style="{StaticResource SidebarButton}"/>
                        </StackPanel>

                        <!-- GAL -->
                        <Button 
                            x:Name="BtnGal"
                            HorizontalContentAlignment="Left"
                            Padding="14,10" 
                            FontSize="13" 
                            Style="{StaticResource SidebarButton}"
                            Click="BtnGal_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧪  Gal" VerticalAlignment="Center"/>
                                <TextBlock x:Name="GalChevron" Text="  ∨"
                                   Foreground="#6B7280" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="GalSubmenu" Style="{StaticResource SubmenuPanel}">
                            <Button 
                                Content="    Amostras mensais"
                                HorizontalContentAlignment="Left"
                                Padding="14,8" 
                                FontSize="12" 
                                Style="{StaticResource SidebarButton}"/>
                            <Button 
                                Content="    Amostras anuais"
                                HorizontalContentAlignment="Left"
                                Padding="14,8" 
                                FontSize="12" 
                                Style="{StaticResource SidebarButton}"/>
                            <Button 
                                Content="    Controle de SAA"
                                HorizontalContentAlignment="Left"
                                Padding="14,8" 
                                FontSize="12" 
                                Style="{StaticResource SidebarButton}"/>
                        </StackPanel>

                        <!-- Idaron -->
                        <Button 
                            x:Name="BtnIdaron"
                            HorizontalContentAlignment="Left"
                            Padding="14,10" 
                            FontSize="13" 
                            Style="{StaticResource SidebarButton}"
                            Click="BtnIdaron_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌿  Idaron" VerticalAlignment="Center"/>
                                <TextBlock x:Name="IdaronChevron" Text="  ∨"
                                   Foreground="#6B7280" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="IdaronSubmenu" Style="{StaticResource SubmenuPanel}">
                            <Button 
                                Content="    Em desenvolvimento"
                                HorizontalContentAlignment="Left"
                                Padding="14,8" 
                                FontSize="12" 
                                Style="{StaticResource SidebarButton}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border
            x:Name="HomePanel"
            Grid.Column="1"
            Grid.Row="1">

            <StackPanel
        VerticalAlignment="Top"
        HorizontalAlignment="Center"
        Margin="60, 60, 60, 40">

                <TextBlock
            FontSize="72"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Margin="0,0,0,5">
            <Run Text="NRNB" Foreground="#d4d8d5"/>
                </TextBlock>

                <TextBlock
            Text="Núcleo de Riscos Não Biológicos"
            FontSize="32"
            FontWeight="SemiBold"
            Foreground="#d4d8d5"
            HorizontalAlignment="Center"
            Margin="0,0,0,10"/>

                <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,0,0,40">
                    <Image Source="/Assets/Vigiagua_Logo.png"
                   Height="80" Width="80"
                   Stretch="Uniform" Margin="12"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image Source="/Assets/Vigiar_Logo.png"
                   Height="80" Width="80"
                   Stretch="Uniform" Margin="12"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image Source="/Assets/Vigidesastres_Logo.png"
                   Height="80" Width="80"
                   Stretch="Uniform" Margin="12"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
                </StackPanel>

                <TextBlock
            Text="Menu interativo para automação de processos internos de vigilância ambiental. Desenvolvido pela equipe GTVAM / Agevisa. Selecione um módulo no menu à esquerda para começar."
            FontSize="16" Foreground="#6b726e"
            TextWrapping="Wrap" TextAlignment="Center"
            MaxWidth="800" LineHeight="28"/>

                <WrapPanel HorizontalAlignment="Center" Margin="0, 40, 0, 0">

                    <Border Background="#E1F5FE" CornerRadius="8"
                    Padding="20, 16" Margin="8" Width="280">
                        <StackPanel>
                            <TextBlock Text="💧 Vigiagua" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#0277BD" Margin="0, 0, 0, 8"/>
                            <TextBlock FontSize="13" Foreground="#01579B" TextWrapping="Wrap" LineHeight="20"
                                   Text="Vigilância da qualidade da água para consumo humano. Monitoramento de parâmetros físico-químicos e microbiológicos."/>
                        </StackPanel>
                    </Border>

                    <Border Background="#E6F1FB" CornerRadius="8"
                    Padding="20, 16" Margin="8" Width="280">
                        <StackPanel>
                            <TextBlock Text="💨 Vigiar" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#185FA5" Margin="0, 0, 0, 8"/>
                            <TextBlock FontSize="13" Foreground="#1A4F7A" TextWrapping="Wrap" LineHeight="20"
                                   Text="Monitoramento da qualidade do ar. Análise de poluentes atmosféricos e impactos à saúde respiratória."/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FAEEDA" CornerRadius="8"
                    Padding="20,16" Margin="8" Width="280">
                        <StackPanel>
                            <TextBlock Text="⚠ Vigidesastres" FontSize="15" FontWeight="SemiBold"
                       Foreground="#854F0B" Margin="0,0,0,8"/>
                            <TextBlock FontSize="13" Foreground="#6D4008" TextWrapping="Wrap" LineHeight="20"
                       Text="Vigilância em saúde ambiental voltada a eventos e desastres naturais."/>
                        </StackPanel>
                    </Border>
                    <Border Background="#EAF3DE" CornerRadius="8"
                    Padding="20,16" Margin="8" Width="280">
                        <StackPanel>
                            <TextBlock Text="🌿 Vigipeq" FontSize="15" FontWeight="SemiBold"
                       Foreground="#3B6D11" Margin="0,0,0,8"/>
                            <TextBlock FontSize="13" Foreground="#2E5A0D" TextWrapping="Wrap" LineHeight="20"
                       Text="Monitoramento e vigilância da exposição a agrotóxicos e produtos químicos no ambiente."/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border
            x:Name="ConfigPanel"
            Grid.Column="1"
            Grid.Row="1"
            Visibility="Collapsed">

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock
                    Text="Configurações — em construção"
                    Foreground="#d4d8d5"
                    FontSize="20"
                    Margin="0,0,0,20"/>

                <Button
                    Content="← Voltar"
                    Padding="12,6"
                    Cursor="Hand"
                    Click="BtnHome_click"/>
                
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" 
           Grid.Column="1" 
           VerticalAlignment="Bottom" 
           HorizontalAlignment="Right" 
           Margin="15" 
           FontSize="13"
           Foreground="AntiqueWhite"
           Visibility="Visible">
            <InlineUIContainer BaselineAlignment="Center">
                <Image Source="/Assets/github-mark-white.png"
                Height="16" Width="16"
                RenderOptions.BitmapScalingMode="HighQuality"
                Margin="0,0,4,0"/>
            </InlineUIContainer>
            <Hyperlink
                Foreground="AntiqueWhite"
                NavigateUri="https://github.com/Dinorroxin/NRNB_MENU"
                RequestNavigate="Hyperlink_RequestNavigate">
                github.com/Dinorroxin/NRNB_MENU
            </Hyperlink>
        </TextBlock>

    </Grid>
</Window>