<views:BaseView x:Class="Hud_Principal.Views.VigiarIqArView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:Hud_Principal.Views"
                Background="#0d0f0e">

    <DockPanel>

        <Button DockPanel.Dock="Top"
                Content="← Voltar"
                HorizontalAlignment="Left"
                Style="{StaticResource SidebarButton}"
                FontSize="13"
                Padding="10,6"
                Margin="20,16,0,0"
                Click="BtnHome_Click"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="48,24,48,40">

                <!-- Header -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Vigiar — Vigilância Ambiental em Saúde"
                               FontSize="11" Foreground="#666666"/>
                    <TextBlock Text="Qualidade do Ar (IQAr)"
                               FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Índice de Qualidade do Ar · Observatório Fiocruz · Rondônia"
                               FontSize="14" Foreground="#999999"/>
                </StackPanel>

                <Separator Background="#2a2a2a" Margin="0,0,0,24"/>

                <!-- Logo -->
                <Image Width="180" Height="180"
                       Margin="0,0,0,24"
                       HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="/Assets/Vigiar_Logo.png"/>

                <!-- Description -->
                <TextBlock TextWrapping="Wrap"
                           Foreground="#cccccc"
                           FontSize="13"
                           Margin="0,0,0,8">
                    Coleta o IQAr previsto por município via Shiny app do Observatório de Saúde
                    e Ambiente da Fiocruz, gravando em planilha mestre para alimentar os
                    dashboards Power BI da GTVAM.
                </TextBlock>

                <TextBlock TextWrapping="Wrap"
                           Foreground="#666666"
                           FontSize="12"
                           Margin="0,0,0,32">
                    Os dados são previsão (rolling forecast) — cada execução sobrescreve o
                    master inteiro, sem checkpoint.
                </TextBlock>

                <Separator Background="#2a2a2a" Margin="0,0,0,24"/>

                <!-- Action -->
                <Button x:Name="BtnStart"
                        Content="Atualizar dados"
                        HorizontalAlignment="Left"
                        Style="{StaticResource SidebarButton}"
                        Padding="16,8"
                        Margin="0,0,0,16"
                        Click="BtnStart_Click"/>

                <!-- Status log -->
                <Border Background="#111111"
                        BorderBrush="#2e2e2e"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        MinHeight="60">
                    <ScrollViewer x:Name="StatusScroll"
                                  MaxHeight="300"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtStatus"
                                   Foreground="#9CA3A0"
                                   FontSize="12"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</views:BaseView>
