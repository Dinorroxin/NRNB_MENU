<views:BaseView x:Class="Hud_Principal.Views.AnnualSisaguaImplementation"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:views="clr-namespace:Hud_Principal.Views"
               Background="#0d0f0e">

    <DockPanel>

        <Button DockPanel.Dock="Top"
                Content="&#x2190; Voltar"
                HorizontalAlignment="Left"
                Style="{StaticResource SidebarButton}"
                FontSize="13"
                Padding="10,6"
                Margin="20,16,0,0"
                Click="BtnHome_Click"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!--Introdução do programa-->
            <StackPanel Margin="48,24,48,40">

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Vigiagua &#x2014; Vigilância da Qualidade da Água para Consumo Humano"
                               FontSize="11" Foreground="#666666"/>
                    <TextBlock Text="Diretriz Nacional &#x2014; Anual"
                               FontSize="22" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <Separator Background="#2a2a2a" Margin="0,0,0,24"/>

                <!-- Logo -->
                <Image Width="140" Height="140"
                       Margin="0,0,0,24"
                       HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="/Assets/Vigiagua_Logo.png"/>

                <TextBlock 
                    TextWrapping="Wrap"
                    Foreground="#cccccc"
                    FontSize="13"
                    Margin="0,0,0,8">
                    Esta automação consiste em verificar o relatório de implementação anual do Sisagua, baixando os arquivos de cada município e verificando a situação do município 
                    (cadastro, controle e vigilância), atualizando a planilha mestra anual do Power BI.
                </TextBlock>

                <Separator Background="#2a2a2a" Margin="0,24,0,24"/>

                <!-- Seleção de anos -->
                <StackPanel Margin="0,0,0,32">
                    <TextBlock Text="Anos a processar" Foreground="#999999" FontSize="12" Margin="0,0,0,6"/>
                    <ListBox x:Name="LstYears"
                             SelectionMode="Multiple"
                             Height="120"
                             Background="#1a1a1a"
                             Foreground="#e5e7e6"
                             BorderBrush="#333333"
                             BorderThickness="1"
                             FontSize="13"
                             Width="200"
                             HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Action -->
                <Button x:Name="BtnStartImplementation"
                        Content="Iniciar Processo"
                        HorizontalAlignment="Left"
                        Style="{StaticResource SidebarButton}"
                        Padding="16,8"
                        Margin="0,0,0,16"
                        Click="BtnStartImplementation_Click"/>

                <TextBlock x:Name="TxtStatus"
                           Foreground="#666666"
                           FontSize="12"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</views:BaseView>
