<Window
    x:Class="Hud_Principal.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:hud_principal"
    mc:Ignorable="d"
    Title="Núcleo de Riscos Não Biológicos" 
    Height="900" 
    Width="1600"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanMinimize"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0" 
            Grid.Column="0" 
            Grid.ColumnSpan="2"
            Background="#0d0f0e "
            BorderBrush="#E5E7E6"
            BorderThickness="0,0,0,1"
            Padding="24,0">

            <DockPanel VerticalAlignment="Center">
                <Button
                    DockPanel.Dock="Right"
                    Content="⚙ Configurações"
                    FontSize="13"
                    Padding="12,6"
                    Cursor="Hand"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#1D9E75" Margin="0,0,10,0"/>
                    <TextBlock Text="NRNB" FontSize="16" FontWeight="Medium" Foreground="#1D9E75"/>
                    <TextBlock Text="  v0.1.0-alpha" FontSize="12" Foreground="#9CA3A0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Background="#0d0f0e"
            BorderBrush="#E5E7E6"
            BorderThickness="0,0,1,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock 
                        Text="MENU" 
                        FontSize="10" 
                        Foreground="#1D9E75 "
                        Margin="14,18,0,4" 
                        FontWeight="SemiBold"/>

                    <Button 
                        Content="🏠  Início" 
                        HorizontalContentAlignment="Left"
                        Padding="14,10" 
                        FontSize="14" 
                        Cursor="Hand"
                        Background="Transparent" 
                        BorderThickness="0"
                        Foreground="White"/>

                    <TextBlock 
                        Text="MÓDULOS" 
                        FontSize="10" 
                        Foreground="#1D9E75 "
                        Margin="14,18,0,4"
                        FontWeight="SemiBold"/>

                    <Button 
                        Content="📄  Conversor de arquivos" 
                        HorizontalContentAlignment="Left"
                        Padding="14,10" 
                        FontSize="14" 
                        Cursor="Hand"
                        Background="Transparent" 
                        BorderThickness="0"
                        Foreground="White"/>

                    <Button 
                        Content="💧  Vigiagua" 
                        HorizontalContentAlignment="Left"
                        Padding="14,10" 
                        FontSize="14" 
                        Cursor="Hand"
                        Background="Transparent" 
                        BorderThickness="0"
                        Foreground="White"/>

                    <Button 
                        Content="🧪  GAL" 
                        HorizontalContentAlignment="Left"
                        Padding="14,10" 
                        FontSize="14" 
                        Cursor="Hand"
                        Background="Transparent" 
                        BorderThickness="0"
                        Foreground="White" Click="Button_Click_1"/>

                    <TextBlock 
                        Text="SISTEMA" 
                        FontSize="10" 
                        Foreground="#1D9E75"
                        Margin="14,18,0,4" 
                        FontWeight="SemiBold"/>

                    <Button 
                        Content="⚙  Configurações" 
                        HorizontalContentAlignment="Left"
                        Padding="14,10" 
                        FontSize="14" 
                        Cursor="Hand"
                        Background="Transparent" 
                        BorderThickness="0"
                        Foreground="White"/>

                    <TextBlock 
                        Text="Felipe Siqueira Ramos Galvez" 
                        FontSize="11" 
                        Foreground="#9CA3A0" 
                        HorizontalAlignment="Center"/>

                </StackPanel>

            </ScrollViewer>
        </Border>

        <StackPanel 
            Grid.Row="1" 
            Grid.Column="1" 
            VerticalAlignment="Center" 
            HorizontalAlignment="Center" 
            Margin="60,0">

            <TextBlock 
                Text="NRNB" 
                FontSize="72" 
                FontWeight="Bold" 
                Foreground="#000000" 
                HorizontalAlignment="Center"
                Margin="0,0,0,5"/>

            <TextBlock 
                Text="Núcleo de Riscos Não Biológicos" 
                FontSize="36" 
                FontWeight="SemiBold" 
                Foreground="#000000" 
                HorizontalAlignment="Center"
                Margin="0,0,0,10"/>

            <TextBlock 
                Text="Logo dos Programas" 
                FontSize="24" 
                Foreground="#333333" 
                HorizontalAlignment="Center"
                Margin="0,0,0,80"/>

            <TextBlock 
                Text="Breve resumo do que é o projeto com definição do que é esse núcleo, seus programas, motivo da escolha de cores, instruções básicas sobre o menu e como utilizar" 
                FontSize="20" 
                Foreground="#1A1A1A" 
                TextWrapping="Wrap" 
                TextAlignment="Center" 
                MaxWidth="900"
                LineHeight="32"/>

        </StackPanel>

    </Grid>
</Window>