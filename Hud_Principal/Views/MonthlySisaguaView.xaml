<local:BaseView x:Class="Hud_Principal.Views.MonthlySisaguaView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Hud_Principal.Views"
      mc:Ignorable="d">

    <Grid>

        <!-- Botão Voltar, mesmo padrão do ConfigView -->
        <Button
            FontSize="15"
            Content="← Voltar"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource SidebarButton}"
            Padding="10,6"
            Margin="20,20,0,0"
            Click="BtnHome_Click"/>

        <!-- Conteúdo central -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="1000">

            <Image
                Source="/Assets/Vigiagua_Logo.png"
                Width="200"
                Height="200"
                Margin="0,0,0,30"/>

            <TextBlock
                Text="Processo de Automação de Diretrizes do Sisagua"
                FontSize="27"
                FontWeight="Bold"
                Foreground="#e5e7e6"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Margin="0,0,0,20"/>

            <TextBlock
                Text="Este processo automatiza a coleta e o tratamento dos dados de cumprimento das diretrizes mensais do Sisagua, atualizando a planilha mestra utilizada pelos dashboards do Power BI. Os passos são:"
                FontSize="20"
                Foreground="#b5b8b7"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Margin="0,20,0,15"/>
            <TextBlock
                Text="1. Leitura da planilha bruta baixada do Sisagua "
                FontSize="20"
                Foreground="#b5b8b7"
                TextAlignment="Left"
                TextWrapping="Wrap"
                Margin="0,0,0,5"/>
            <TextBlock
                Text="2. Remoção dos dados do ano corrente já existentes na planilha mestra."
                FontSize="20"
                Foreground="#b5b8b7"
                TextAlignment="Left"
                TextWrapping="Wrap"
                Margin="0,0,0,5"/>
            <TextBlock
                Text="3. Conversão dos dados para o formato longo."
                FontSize="20"
                Foreground="#b5b8b7"
                TextAlignment="Left"
                TextWrapping="Wrap"
                Margin="0,0,0,5"/>
            <TextBlock
                Text="4. Inclusão dos novos registros atualizados."
                FontSize="20"
                Foreground="#b5b8b7"
                TextAlignment="Left"
                TextWrapping="Wrap"
                Margin="0,0,0,5"/>

            <TextBlock
                Text="Selecionar anos:"
                FontSize="16"
                Foreground="#b5b8b7"
                Margin="0,20,0,8"/>

            <ListBox
                x:Name="LstAnos"
                SelectionMode="Multiple"
                MaxHeight="100"
                Background="#1a1a1a"
                Foreground="#e5e7e6"
                BorderBrush="#333"
                FontSize="15"
                Margin="0,0,0,10"/>

            <Button
                x:Name="StartMonthlySisagua"
                Content="Iniciar Processo"
                FontSize="30"
                Padding="20,10"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource SidebarButton}"
                Click="BtnStartMonthly_Click"/>

            <TextBlock
                x:Name="TxtStatus"
                Text=""
                FontSize="16"
                Foreground="#b5b8b7"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Margin="0,15,0,0"/>

        </StackPanel>
        
        <!-- Botão Voltar, mesmo padrão do ConfigView -->
        <Button
            FontSize="15"
            Content="← Voltar"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource SidebarButton}"
            Padding="10,6"
            Margin="20,20,0,0"
            Click="BtnHome_Click"/>

    </Grid>
</local:BaseView>