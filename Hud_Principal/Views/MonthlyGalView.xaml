<views:BaseView x:Class="Hud_Principal.Views.MonthlyGalView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:Hud_Principal.Views"
                Background="#0d0f0e">

    <DockPanel>

        <Button DockPanel.Dock="Top"
                Content="← Voltar"
                HorizontalAlignment="Left"
                Style="{StaticResource SidebarButton}"
                FontSize="13"
                Padding="10,6"
                Margin="20,16,0,0"
                Click="BtnHome_Click"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="48,24,48,40">

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GAL — Sistema Gerenciador de Ambiente Laboratorial"
                                   FontSize="11" Foreground="#666666"/>
                        <TextBlock Text="Relatório de Acompanhamento Mensal"
                                   FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Análise de Água"
                                   FontSize="14" Foreground="#999999"/>
                    </StackPanel>
                </StackPanel>

                <Separator Background="#2a2a2a" Margin="0,0,0,24"/>

                <!-- Steps -->
                <TextBlock Text="O SISTEMA IRÁ:"
                           FontSize="11" Foreground="#555555"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Background="#1e3a1e" CornerRadius="12"
                            Width="24" Height="24" Margin="0,0,10,0">
                        <TextBlock Text="1" Foreground="#4caf50" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Acessar o GAL com as credenciais configuradas"
                               Foreground="#cccccc" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Background="#1e3a1e" CornerRadius="12"
                            Width="24" Height="24" Margin="0,0,10,0">
                        <TextBlock Text="2" Foreground="#4caf50" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Selecionar o módulo e laboratório configurados"
                               Foreground="#cccccc" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Background="#1e3a1e" CornerRadius="12"
                            Width="24" Height="24" Margin="0,0,10,0">
                        <TextBlock Text="3" Foreground="#4caf50" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Gerar e baixar os relatórios mensais de análise de água"
                               Foreground="#cccccc" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                    <Border Background="#1e3a1e" CornerRadius="12"
                            Width="24" Height="24" Margin="0,0,10,0">
                        <TextBlock Text="4" Foreground="#4caf50" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Salvar os arquivos na pasta configurada"
                               Foreground="#cccccc" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <Separator Background="#2a2a2a" Margin="0,0,0,24"/>

                <!-- Parâmetros -->
                <TextBlock Text="PARÂMETROS"
                           FontSize="11" Foreground="#555555"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <!-- Referência -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Referência" Foreground="#999999" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbReferencia" Foreground="Black"
                              Width="260" HorizontalAlignment="Left"
                              Style="{StaticResource FormFieldComboBox}">
                        <ComboBoxItem Content="Data de Cadastro" Foreground="Black" IsSelected="True"/>
                        <ComboBoxItem Content="Data de Coleta" Foreground="Black"/>
                    </ComboBox>
                </StackPanel>

                <!-- Período -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Data Início" Foreground="#999999" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtDataInicio"
                                 Width="140" HorizontalAlignment="Left"
                                 Style="{StaticResource FormField}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Data Fim" Foreground="#999999" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtDataFim"
                                 Width="140" HorizontalAlignment="Left"
                                 Style="{StaticResource FormField}"/>
                    </StackPanel>
                </StackPanel>

                <!-- IBGE -->
                <StackPanel Margin="0,0,0,32">
                    <TextBlock Foreground="#999999" FontSize="12" Margin="0,0,0,6">
                        Código IBGE <Run Foreground="#555555">(deixe 11 para todo o estado)</Run>
                    </TextBlock>
                    <TextBox x:Name="TxtIbge"
                             Width="140" HorizontalAlignment="Left"
                             Style="{StaticResource FormField}"
                             Text="11"/>
                </StackPanel>

                <!-- Action -->
                <TextBlock x:Name="TxtStatus"
                           Foreground="#666666" FontSize="12"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"/>
                <Button x:Name="BtnStart"
                        Content="Iniciar Coleta"
                        HorizontalAlignment="Left"
                        Style="{StaticResource SidebarButton}"
                        Padding="16,8"
                        Click="BtnStart_Click"/>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</views:BaseView>