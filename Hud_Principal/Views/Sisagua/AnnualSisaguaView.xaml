<views:BaseView x:Class="Hud_Principal.Views.AnnualSisaguaView"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:views="clr-namespace:Hud_Principal.Views"
               Background="#0d0f0e">

    <DockPanel>

        <Button DockPanel.Dock="Top"
                Content="&#x2190; Voltar"
                HorizontalAlignment="Left"
                Style="{StaticResource SidebarButton}"
                FontSize="13"
                Padding="10,6"
                Margin="20,16,0,0"
                Click="BtnHome_Click"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="48,24,48,40">

                <!-- Header -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Vigiagua &#x2014; Vigilância da Qualidade da Água para Consumo Humano"
                               FontSize="11" Foreground="#666666"/>
                    <TextBlock Text="Diretriz Nacional &#x2014; Anual"
                               FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Sisagua &#xB7; Cloro Residual Livre &#xB7; Turbidez &#xB7; Coliformes &#xB7; Rond&#xF4;nia"
                               FontSize="14" Foreground="#999999"/>
                </StackPanel>

                <Separator Background="#2a2a2a" Margin="0,0,0,24"/>

                <!-- Logo -->
                <Image Width="140" Height="140"
                       Margin="0,0,0,24"
                       HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="/Assets/Vigiagua_Logo.png"/>

                <!-- Description -->
                <TextBlock TextWrapping="Wrap"
                           Foreground="#cccccc"
                           FontSize="13"
                           Margin="0,0,0,8">
                    Coleta os dados consolidados anuais de cumprimento de diretriz para os
                    tr&#xEA;s par&#xE2;metros principais: Cloro Residual Livre, Turbidez e Coliformes
                    Totais/E. coli, atualizando a planilha mestra anual do Power BI.
                </TextBlock>

                <TextBlock TextWrapping="Wrap"
                           Foreground="#666666"
                           FontSize="12"
                           Margin="0,0,0,32">
                    O processo baixa um arquivo por par&#xE2;metro. Selecione o intervalo de anos
                    desejado antes de iniciar.
                </TextBlock>

                <Separator Background="#2a2a2a" Margin="0,0,0,24"/>

                <!-- Parameters -->
                <TextBlock Text="PAR&#xC2;METROS"
                           FontSize="11" Foreground="#555555"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Ano Inicial" Foreground="#999999" FontSize="12" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbStartYear"
                                  Width="160" HorizontalAlignment="Left"
                                  Foreground="Black"
                                  Style="{StaticResource FormFieldComboBox}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Ano Final" Foreground="#999999" FontSize="12" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbEndYear"
                                  Width="160" HorizontalAlignment="Left"
                                  Foreground="Black"
                                  Style="{StaticResource FormFieldComboBox}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action -->
                <Button x:Name="StartAnnualSisagua"
                        Content="Iniciar Processo"
                        HorizontalAlignment="Left"
                        Style="{StaticResource SidebarButton}"
                        Padding="16,8"
                        Margin="0,0,0,16"
                        Click="BtnStartAnnual_Click"/>

                <TextBlock x:Name="TxtStatus"
                           Foreground="#666666"
                           FontSize="12"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</views:BaseView>
