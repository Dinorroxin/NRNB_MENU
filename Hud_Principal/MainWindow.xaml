<Window
    x:Class="Hud_Principal.MainWindow"
    xmlns:views="clr-namespace:Hud_Principal.Views"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:hud_principal"
    mc:Ignorable="d"
    Title="Núcleo de Riscos Não Biológicos" 
    Height="900" 
    Width="1600"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanMinimize"
    >

    <Grid Background="#0d0f0e">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0" 
            Grid.Column="0" 
            Grid.ColumnSpan="2"
            Background="#1a1a1a "
            BorderBrush="#2e2e2e"
            BorderThickness="0,0,0,1"
            Padding="24,0">

            <DockPanel VerticalAlignment="Center">
                <Button
                    x:Name="BtnConfig"
                    DockPanel.Dock="Right"
                    Content="⚙ Configurações"
                    FontSize="13"
                    Padding="12,6"
                    Cursor="Hand"
                    Click="BtnConfig_Click"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#1D9E75" Margin="0,0,10,0"/>
                    <TextBlock Text="NRNB" FontSize="16" FontWeight="Medium" Foreground="#1D9E75"/>
                    <TextBlock Text="  v0.1.0-alpha" FontSize="12" Foreground="#9CA3A0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border
    Grid.Row="1"
    Grid.Column="0"
    Background="#1a1a1a"
    BorderBrush="#2e2e2e"
    BorderThickness="0,0,1,0">

            <DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,12">
                    <TextBlock 
                        Text="Autor" 
                        FontSize="10"
                        Foreground="#6B7280" 
                        TextAlignment="Center"/>
                    <TextBlock 
                        Text="Felipe Siqueira Ramos Galvez" 
                        FontSize="11"
                        Foreground="#9CA3A0" 
                        TextAlignment="Center"
                        TextWrapping="Wrap"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">

                        <TextBlock 
                            Text="Módulos" 
                            FontSize="11"
                            Foreground="#6B7280" 
                            Margin="14,0,0,8"/>

                        <Button 
                            Content="📄  Conversor de arquivos"
                            HorizontalContentAlignment="Left"
                            Padding="14,10" 
                            FontSize="13" 
                            Style="{StaticResource SidebarButton}"/>

                        <!-- Sisagua -->
                        <Button 
                            x:Name="BtnSisagua"
                            HorizontalContentAlignment="Left"
                            Padding="14,10" 
                            FontSize="13" 
                            Style="{StaticResource SidebarButton}"
                            Click="BtnSisagua_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock 
                                    Text="💧  Sisagua" 
                                    VerticalAlignment="Center"/>
                                <TextBlock 
                                    x:Name="SisaguaChevron" 
                                    Text="  ∨"
                                    Foreground="#6B7280" 
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="SisaguaSubmenu" Style="{StaticResource SubmenuPanel}">
                            <Button 
                                Content="    Automação diretriz mensal"
                                HorizontalContentAlignment="Left"
                                Padding="14,8" 
                                FontSize="12" 
                                Style="{StaticResource SidebarButton}"/>
                            <Button 
                                Content="    Automação diretriz anual"
                                HorizontalContentAlignment="Left"
                                Padding="14,8" 
                                FontSize="12" 
                                Style="{StaticResource SidebarButton}"/>
                        </StackPanel>

                        <!-- GAL -->
                        <Button 
                            x:Name="BtnGal"
                            HorizontalContentAlignment="Left"
                            Padding="14,10" 
                            FontSize="13" 
                            Style="{StaticResource SidebarButton}"
                            Click="BtnGal_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧪  Gal" VerticalAlignment="Center"/>
                                <TextBlock x:Name="GalChevron" Text="  ∨"
                                   Foreground="#6B7280" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="GalSubmenu" Style="{StaticResource SubmenuPanel}">
                            <Button 
                                Content="    Amostras mensais"
                                HorizontalContentAlignment="Left"
                                Padding="14,8" 
                                FontSize="12" 
                                Style="{StaticResource SidebarButton}"/>
                            <Button 
                                Content="    Amostras anuais"
                                HorizontalContentAlignment="Left"
                                Padding="14,8" 
                                FontSize="12" 
                                Style="{StaticResource SidebarButton}"/>
                            <Button 
                                Content="    Controle de SAA"
                                HorizontalContentAlignment="Left"
                                Padding="14,8" 
                                FontSize="12" 
                                Style="{StaticResource SidebarButton}"/>
                        </StackPanel>

                        <!-- Idaron -->
                        <Button 
                            x:Name="BtnIdaron"
                            HorizontalContentAlignment="Left"
                            Padding="14,10" 
                            FontSize="13" 
                            Style="{StaticResource SidebarButton}"
                            Click="BtnIdaron_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌿  Idaron" VerticalAlignment="Center"/>
                                <TextBlock x:Name="IdaronChevron" Text="  ∨"
                                   Foreground="#6B7280" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="IdaronSubmenu" Style="{StaticResource SubmenuPanel}">
                            <Button 
                                Content="    Em desenvolvimento"
                                HorizontalContentAlignment="Left"
                                Padding="14,8" 
                                FontSize="12" 
                                Style="{StaticResource SidebarButton}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <views:HomeView
            x:Name="HomePanel"
            Grid.Column="1"
            Grid.Row="1"/>

        <views:ConfigView
            x:Name="ConfigPanel"
            Grid.Column="1"
            Grid.Row="1"
            Visibility="Collapsed"/>
        

            <TextBlock Grid.Row="1" 
           Grid.Column="1" 
           VerticalAlignment="Bottom" 
           HorizontalAlignment="Right" 
           Margin="15" 
           FontSize="13"
           Foreground="AntiqueWhite"
           Visibility="Visible">
            <InlineUIContainer BaselineAlignment="Center">
                <Image Source="/Assets/github-mark-white.png"
                Height="16" Width="16"
                RenderOptions.BitmapScalingMode="HighQuality"
                Margin="0,0,4,0"/>
            </InlineUIContainer>
            <Hyperlink
                Foreground="AntiqueWhite"
                NavigateUri="https://github.com/Dinorroxin/NRNB_MENU"
                RequestNavigate="Hyperlink_RequestNavigate">
                github.com/Dinorroxin/NRNB_MENU
            </Hyperlink>
        </TextBlock>

    </Grid>
</Window>