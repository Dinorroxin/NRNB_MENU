<views:BaseView
    x:Class="Hud_Principal.Views.ConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:views="clr-namespace:Hud_Principal.Views"
    mc:Ignorable="d"
    Background="#0d0f0e">

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,60,0,0">
            <StackPanel Margin="40,10" MaxWidth="500">

                <!-- Header -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="NRNB &#x2014; N&#xFA;cleo de Rede de Notifica&#xE7;&#xE3;o e Banco de Dados"
                               FontSize="11" Foreground="#666666"/>
                    <TextBlock Text="Configura&#xE7;&#xF5;es"
                               FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Credenciais e pastas para cada m&#xF3;dulo de automa&#xE7;&#xE3;o"
                               FontSize="14" Foreground="#999999"/>
                </StackPanel>

                <Separator Background="#2a2a2a" Margin="0,0,0,20"/>

                <Button
                    x:Name="BtnVigiaguaSection"
                    Content="💧 Vigiagua"
                    HorizontalAlignment="Left"
                    FontSize="25"
                    Padding="14,10"
                    Style="{StaticResource SidebarButton}"
                    Click="BtnVigiaguaSection_Click"/>

                <StackPanel x:Name="VigiaguaSection" Style="{StaticResource SubmenuPanel}" Margin="14,10,0,0">

                    <TextBlock Text="Email" Foreground="#9CA3A0" Margin="0,8,0,4"/>
                    <TextBox x:Name="TxtEmail" Style="{StaticResource FormField}"/>

                    <TextBlock Text="Password" Foreground="#9CA3A0" Margin="0,8,0,4"/>
                    <Grid>
                        <PasswordBox x:Name="TxtPassword" Style="{StaticResource PasswordFormField}"/>
                        <TextBox x:Name="TxtPasswordVisible" Style="{StaticResource FormField}" Visibility="Collapsed"/>
                        <Button
                            x:Name="BtnTogglePassword"
                            Content="👁"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            FontSize="14"
                            Background="#1f1f1f"
                            Foreground="#e5e7e6"
                            BorderBrush="#3a3a3a"
                            BorderThickness="1"
                            Padding="10,0"
                            Cursor="Hand"
                            Click="BtnTogglePassword_Click"/>
                    </Grid>

                    <TextBlock Text="Pasta Brutos" Foreground="#9CA3A0" Margin="0,8,0,4"/>
                    <DockPanel LastChildFill="True">
                        <Button
                            Content="📁"
                            DockPanel.Dock="Right"
                            Style="{StaticResource FolderButton}"
                            Click="BtnRawFolderDirective_Click"/>
                        <TextBox x:Name="TxtRawFolder" Style="{StaticResource FormField}" IsReadOnly="True"/>
                    </DockPanel>

                    <TextBlock Text="Pasta Diretriz Mensal" Foreground="#9CA3A0" Margin="0,8,0,4"/>
                    <DockPanel LastChildFill="True">
                        <Button
                            Content="📁"
                            DockPanel.Dock="Right"
                            Style="{StaticResource FolderButton}"
                            Click="BtnMonthlyDirectiveFolder_Click"/>
                        <TextBox x:Name="TxtMonthlyDirectiveFolder" Style="{StaticResource FormField}" IsReadOnly="True"/>
                    </DockPanel>

                    <TextBlock Text="Pasta Diretriz Anual" Foreground="#9CA3A0" Margin="0,8,0,4"/>
                    <DockPanel LastChildFill="True">
                        <Button
                            Content="📁"
                            DockPanel.Dock="Right"
                            Style="{StaticResource FolderButton}"
                            Click="BtnAnnualDirectiveFolder_Click"/>
                        <TextBox x:Name="TxtAnnualDirectiveFolder" Style="{StaticResource FormField}" IsReadOnly="True"/>
                    </DockPanel>

                    <TextBlock Text="Pasta Controle" Foreground="#9CA3A0" Margin="0,8,0,4"/>
                    <DockPanel LastChildFill="True">
                        <Button
                            Content="📁"
                            DockPanel.Dock="Right"
                            Style="{StaticResource FolderButton}"
                            Click="BtnControlFolder_Click"/>
                        <TextBox x:Name="TxtControlFolder" Style="{StaticResource FormField}" IsReadOnly="True"/>
                    </DockPanel>

                </StackPanel>

                <Button
                    x:Name="BtnGalSection"
                    Content="🧪 GAL"
                    HorizontalAlignment="Left"
                    FontSize="25"
                    Padding="14,10"
                    Style="{StaticResource SidebarButton}"
                    Click="BtnGalSection_Click"/>

                <StackPanel x:Name="GalSection" Style="{StaticResource SubmenuPanel}" Margin="14,10,0,0">

                    <TextBlock Text="Usuário" Foreground="#9CA3A0" Margin="0,8,0,4"/>
                    <TextBox x:Name="TxtGalUsername" Style="{StaticResource FormField}"/>

                    <TextBlock Text="Senha" Foreground="#9CA3A0" Margin="0,8,0,4"/>
                    <Grid>
                        <PasswordBox x:Name="TxtGalPassword" Style="{StaticResource PasswordFormField}"/>
                        <TextBox x:Name="TxtGalPasswordVisible" Style="{StaticResource FormField}" Visibility="Collapsed"/>
                        <Button
                            x:Name="BtnToggleGalPassword"
                            Content="👁"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            FontSize="14"
                            Background="#1f1f1f"
                            Foreground="#e5e7e6"
                            BorderBrush="#3a3a3a"
                            BorderThickness="1"
                            Padding="10,0"
                            Cursor="Hand"
                            Click="BtnToggleGalPassword_Click"/>
                    </Grid>

                    <TextBlock Text="Módulo" Foreground="#9CA3A0" Margin="0,8,0,4"/>
                    <TextBox x:Name="TxtGalModule" Style="{StaticResource FormField}"/>

                    <TextBlock Text="Laboratório" Foreground="#9CA3A0" Margin="0,8,0,4"/>
                    <TextBox x:Name="TxtGalLaboratory" Style="{StaticResource FormField}"/>

                    <TextBlock Text="Pasta Relatórios Brutos Mensal" Foreground="#9CA3A0" Margin="0,8,0,4"/>
                    <DockPanel LastChildFill="True">
                        <Button Content="📁" DockPanel.Dock="Right"
                Style="{StaticResource FolderButton}"
                Click="BtnGalRawFolderClick"/>
                        <TextBox x:Name="TxtGalRawFolder"
                 Style="{StaticResource FormField}" IsReadOnly="True"/>
                    </DockPanel>

                    <TextBlock Text="Pasta Relatórios Tratados Mensal" Foreground="#9CA3A0" Margin="0,8,0,4"/>
                    <DockPanel LastChildFill="True">
                        <Button Content="📁" DockPanel.Dock="Right"
                Style="{StaticResource FolderButton}"
                Click="BtnGalMonthlyFolderClick"/>
                        <TextBox x:Name="TxtGalMonthlyFolder"
                 Style="{StaticResource FormField}" IsReadOnly="True"/>
                    </DockPanel>

                </StackPanel>

                <Button
                    x:Name="BtnVigiarSection"
                    Content="🔥 Vigiar"
                    HorizontalAlignment="Left"
                    FontSize="25"
                    Padding="14,10"
                    Style="{StaticResource SidebarButton}"
                    Click="BtnVigiarSection_Click"/>

                <StackPanel x:Name="VigiarSection" Style="{StaticResource SubmenuPanel}" Margin="14,10,0,0">

                    <TextBlock Text="Pasta Queimadas" Foreground="#9CA3A0" Margin="0,8,0,4"/>
                    <DockPanel LastChildFill="True">
                        <Button Content="📁" DockPanel.Dock="Right"
                                Style="{StaticResource FolderButton}"
                                Click="BtnVigiarWildfiresFolder_Click"/>
                        <TextBox x:Name="TxtVigiarWildfiresFolder"
                                 Style="{StaticResource FormField}" IsReadOnly="True"/>
                    </DockPanel>

                    <TextBlock Text="Pasta Arquivos Brutos" Foreground="#9CA3A0" Margin="0,8,0,4"/>
                    <DockPanel LastChildFill="True">
                        <Button Content="📁" DockPanel.Dock="Right"
                                Style="{StaticResource FolderButton}"
                                Click="BtnVigiarRawFolder_Click"/>
                        <TextBox x:Name="TxtVigiarRawFolder"
                                 Style="{StaticResource FormField}" IsReadOnly="True"/>
                    </DockPanel>

                    <TextBlock Text="Pasta IQAr" Foreground="#9CA3A0" Margin="0,8,0,4"/>
                    <DockPanel LastChildFill="True">
                        <Button Content="📁" DockPanel.Dock="Right"
                                Style="{StaticResource FolderButton}"
                                Click="BtnVigiarIqArFolder_Click"/>
                        <TextBox x:Name="TxtVigiarIqArFolder"
                                 Style="{StaticResource FormField}" IsReadOnly="True"/>
                    </DockPanel>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Button
            FontSize="15"
            Content="← Voltar"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource SidebarButton}"
            Padding="10,6"
            Margin="20,20,0,0"
            Click="BtnHome_Click"/>

        <Button
            FontSize="15"
            Content="💾 Salvar"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Style="{StaticResource SidebarButton}"
            Padding="10,6"
            Margin="0,20,20,0"
            Click="BtnSave_Click"/>

    </Grid>
</views:BaseView>
