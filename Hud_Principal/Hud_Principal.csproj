<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Conversor_de_Arquivos\Conversor_de_Arquivos.csproj" />
		<ProjectReference Include="..\Modulo_Seguranca\Modulo_Seguranca.csproj" />
		<ProjectReference Include="..\WebAutomation\WebAutomation.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\github-mark-white.png" />
		<Resource Include="Assets\Vigiagua_Logo.png" />
		<Resource Include="Assets\Vigiar_Logo.png" />
		<Resource Include="Assets\Vigidesastres_Logo.png" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\captcha_solver.exe">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="..\gal_extract.exe">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!--
		Mantém Microsoft.Playwright.dll como arquivo solto ao lado do .exe
		(não embutida no bundle). Necessário porque a DLL usa Assembly.Location
		internamente para localizar o driver .playwright\node\win32_x64\node.exe.
		Em single-file, Assembly.Location retorna string vazia → CodeBase → exceção.
	-->
	<Target Name="ExcludeNativeExecutablesFromSingleFile" BeforeTargets="_ComputeFilesToBundle">
		<ItemGroup>
			<ResolvedFileToPublish
				Condition="('%(ResolvedFileToPublish.FileName)' == 'Microsoft.Playwright' And '%(ResolvedFileToPublish.Extension)' == '.dll')
							Or ('%(ResolvedFileToPublish.FileName)' == 'node' And '%(ResolvedFileToPublish.Extension)' == '.exe')
							Or ('%(ResolvedFileToPublish.FileName)' == 'captcha_solver' And '%(ResolvedFileToPublish.Extension)' == '.exe')
							Or ('%(ResolvedFileToPublish.FileName)' == 'gal_extract' And '%(ResolvedFileToPublish.Extension)' == '.exe')">
				<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

	<!--
		Copia o Chromium já baixado nesta máquina (via download anterior)
		direto para playwright-browsers\ dentro do output de publish.
		Não depende de node.exe nem roda instalador — só copia arquivos já existentes.
	-->
	<Target Name="ExportPlaywrightBrowsers" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
		<ItemGroup>
			<PlaywrightBrowserFiles Include="$(USERPROFILE)\AppData\Local\ms-playwright\chromium-*\**\*.*;$(USERPROFILE)\AppData\Local\ms-playwright\ffmpeg-*\**\*.*"/>
		</ItemGroup>
		<Error Condition="'@(PlaywrightBrowserFiles)' == ''"
			   Text="Chromium não encontrado em $(USERPROFILE)\AppData\Local\ms-playwright. Rode uma automação Playwright nesta máquina antes de publicar."/>
		<Copy SourceFiles="@(PlaywrightBrowserFiles)"
			  DestinationFolder="$(PublishDir)playwright-browsers\%(RecursiveDir)"
			  SkipUnchangedFiles="true"/>
	</Target>
	
</Project>