<Window x:Class="Hud_Principal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hud_principal"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Caminho de Entrada (Arquivo ou Pasta):" Margin="0,10,0,5"/>
            <DockPanel>
                <Button x:Name="BtnSelecionarEntrada" Content="Selecionar" Width="80" DockPanel.Dock="Right" Click="BtnSelecionarEntrada_Click"/>
                <TextBox x:Name="TxtEntrada" IsReadOnly="True" Margin="0,0,5,0"/>
            </DockPanel>

            <TextBlock Text="Diretório de Saída:" Margin="0,20,0,5"/>
            <DockPanel>
                <Button x:Name="BtnSelecionarSaida" Content="Selecionar" Width="80" DockPanel.Dock="Right" Click="BtnSelecionarSaida_Click"/>
                <TextBox x:Name="TxtSaida" IsReadOnly="True" Margin="0,0,5,0"/>
            </DockPanel>

            <Button x:Name="BtnProcessar" Content="Iniciar Processamento" Margin="0,30,0,0" Height="40" Background="Green" Foreground="White" Click="BtnProcessar_Click"/>
        </StackPanel>

    </Grid>
</Window>
