<views:BaseView x:Class="Hud_Principal.Views.SisamPrevisaoView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="clr-namespace:Hud_Principal.Views"
                Background="#0d0f0e">

    <DockPanel>

        <Button DockPanel.Dock="Top"
                Content="← Voltar"
                HorizontalAlignment="Left"
                Style="{StaticResource SidebarButton}"
                FontSize="13"
                Padding="10,6"
                Margin="20,16,0,0"
                Click="BtnHome_Click"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="48,24,48,40">

                <!-- Header -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="SISAM — Sistema de Suporte a Alertas de Material Particulado"
                               FontSize="11" Foreground="#666666"/>
                    <TextBlock Text="Previsão de Qualidade do Ar"
                               FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Previsão de poluentes · INPE/SISAM · Rondônia"
                               FontSize="14" Foreground="#999999"/>
                </StackPanel>

                <Separator Background="#2a2a2a" Margin="0,0,0,24"/>

                <!-- Description -->
                <TextBlock TextWrapping="Wrap"
                           Foreground="#cccccc"
                           FontSize="13"
                           Margin="0,0,0,8">
                    Coleta previsões de concentração de poluentes via API do SISAM/INPE
                    para os municípios de Rondônia, gravando em planilha mestre para
                    alimentar os dashboards Power BI da GTVAM.
                </TextBlock>

                <TextBlock TextWrapping="Wrap"
                           Foreground="#666666"
                           FontSize="12"
                           Margin="0,0,0,32">
                    Cada poluente é salvo individualmente — uma falha não interrompe os demais.
                </TextBlock>

                <Separator Background="#2a2a2a" Margin="0,0,0,24"/>

                <!-- Poluentes -->
                <TextBlock Text="Poluentes"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="White" Margin="0,0,0,12"/>

                <WrapPanel Margin="0,0,0,4">
                    <CheckBox x:Name="ChkPm25" Content="MP2.5" IsChecked="True"
                              Foreground="#e5e7e6" Margin="0,0,24,10"/>
                    <CheckBox x:Name="ChkPm10" Content="MP10"  IsChecked="True"
                              Foreground="#e5e7e6" Margin="0,0,24,10"/>
                    <CheckBox x:Name="ChkO3"   Content="O3"    IsChecked="False"
                              Foreground="#e5e7e6" Margin="0,0,24,10"/>
                    <CheckBox x:Name="ChkNo2"  Content="NO2"   IsChecked="False"
                              Foreground="#e5e7e6" Margin="0,0,24,10"/>
                    <CheckBox x:Name="ChkSo2"  Content="SO2"   IsChecked="False"
                              Foreground="#e5e7e6" Margin="0,0,24,10"/>
                    <CheckBox x:Name="ChkCo"   Content="CO"    IsChecked="False"
                              Foreground="#e5e7e6" Margin="0,0,24,10"/>
                </WrapPanel>

                <!-- Progress label -->
                <TextBlock x:Name="TxtProgresso"
                           Foreground="#1D9E75"
                           FontSize="12"
                           FontFamily="Consolas"
                           Margin="0,8,0,8"
                           Visibility="Collapsed"/>

                <!-- Action -->
                <Button x:Name="BtnStart"
                        Content="Atualizar dados"
                        HorizontalAlignment="Left"
                        Style="{StaticResource SidebarButton}"
                        Padding="16,8"
                        Margin="0,0,0,16"
                        Click="BtnStart_Click"/>

                <!-- Status log -->
                <Border Background="#111111"
                        BorderBrush="#2e2e2e"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        MinHeight="60">
                    <ScrollViewer x:Name="StatusScroll"
                                  MaxHeight="300"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtStatus"
                                   Foreground="#9CA3A0"
                                   FontSize="12"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</views:BaseView>
