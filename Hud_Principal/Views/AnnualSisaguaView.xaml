<local:BaseView x:Class="Hud_Principal.Views.AnnualSisaguaView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Hud_Principal.Views"
      mc:Ignorable="d"
      d:Height="840" d:Width="1400">

    <Grid>

        <Button
            FontSize="15"
            Content="← Voltar"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource SidebarButton}"
            Padding="10,6"
            Margin="20,20,0,0"
            Click="BtnHome_Click"/>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="1000">

            <Image
                Source="/Assets/Vigiagua_Logo.png"
                Width="200"
                Height="200"
                Margin="0,0,0,30"/>

            <TextBlock
                Text="Processo de Automação Anual de Diretrizes do Sisagua"
                FontSize="27"
                FontWeight="Bold"
                Foreground="#e5e7e6"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Margin="0,0,0,20"/>

            <TextBlock
                Text="Selecione o intervalo de anos:"
                FontSize="16"
                Foreground="#b5b8b7"
                TextAlignment="Center"
                Margin="0,10,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Ano Inicial" Foreground="#b5b8b7" FontSize="14"
                               TextAlignment="Center" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbAnoInicial" Width="120" FontSize="15"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Ano Final" Foreground="#b5b8b7" FontSize="14"
                               TextAlignment="Center" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbAnoFinal" Width="120" FontSize="15"/>
                </StackPanel>
            </StackPanel>

            <Button
                x:Name="StartAnnualSisagua"
                Content="Iniciar Processo"
                FontSize="30"
                Padding="20,10"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource SidebarButton}"
                Click="BtnStartAnnual_Click"/>

            <TextBlock
                x:Name="TxtStatus"
                Text=""
                FontSize="16"
                Foreground="#b5b8b7"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Margin="0,15,0,0"/>

        </StackPanel>
    </Grid>
</local:BaseView>