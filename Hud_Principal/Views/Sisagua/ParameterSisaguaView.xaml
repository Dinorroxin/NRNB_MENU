<views:BaseView x:Class="Hud_Principal.Views.ParameterSisaguaView"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:views="clr-namespace:Hud_Principal.Views"
               Background="#0d0f0e">

    <DockPanel>

        <Button DockPanel.Dock="Top"
                Content="&#x2190; Voltar"
                HorizontalAlignment="Left"
                Style="{StaticResource SidebarButton}"
                FontSize="13"
                Padding="10,6"
                Margin="20,16,0,0"
                Click="BtnHome_Click"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="48,24,48,40">

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Vigiagua &#x2014; Vigilância da Qualidade da Água para Consumo Humano"
                               FontSize="11" Foreground="#666666"/>
                    <TextBlock Text="Amostras Analisadas"
                               FontSize="22" FontWeight="Bold" Foreground="White"/>
                </StackPanel>

                <Separator Background="#2a2a2a" Margin="0,0,0,24"/>

                <Image Width="140" Height="140"
                       Margin="0,0,0,24"
                       HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="/Assets/Vigiagua_Logo.png"/>

                <Separator Background="#2a2a2a" Margin="0,0,0,24"/>

                <!-- Anos -->
                <StackPanel Margin="0,0,0,32">
                    <TextBlock Text="Anos a processar" Foreground="#999999" FontSize="12" Margin="0,0,0,6"/>
                    <ListBox x:Name="LstYears"
                             SelectionMode="Multiple"
                             Height="120"
                             Background="#1a1a1a"
                             Foreground="#e5e7e6"
                             BorderBrush="#333333"
                             BorderThickness="1"
                             FontSize="13"
                             Width="200"
                             HorizontalAlignment="Left"/>
                </StackPanel>

                <Separator Background="#2a2a2a" Margin="0,0,0,24"/>

                <!-- Informações gerais da coleta -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="Informações gerais da coleta"
                               FontSize="14" FontWeight="SemiBold" Foreground="#e5e7e6"
                               Margin="0,0,0,12"/>
                    <CheckBox x:Name="ChkInfoTodos"
                              Content="Todos"
                              Foreground="#e5e7e6"
                              FontSize="13"
                              FontWeight="SemiBold"
                              Margin="0,0,0,10"
                              Checked="ChkInfoTodos_Checked"
                              Unchecked="ChkInfoTodos_Unchecked"/>
                    <WrapPanel>
                        <CheckBox x:Name="ChkMunicipio"
                                  Content="Município"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="InfoItem_Changed" Unchecked="InfoItem_Changed"/>
                        <CheckBox x:Name="ChkMotivo"
                                  Content="Motivo"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="InfoItem_Changed" Unchecked="InfoItem_Changed"/>
                        <CheckBox x:Name="ChkNome"
                                  Content="Nome (SAA, SAC, SAI ou CARRO-PIPA)"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="InfoItem_Changed" Unchecked="InfoItem_Changed"/>
                        <CheckBox x:Name="ChkZona"
                                  Content="Zona"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="InfoItem_Changed" Unchecked="InfoItem_Changed"/>
                        <CheckBox x:Name="ChkNumeroAmostra"
                                  Content="Nº da amostra"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="InfoItem_Changed" Unchecked="InfoItem_Changed"/>
                        <CheckBox x:Name="ChkDataColeta"
                                  Content="Data da coleta"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="InfoItem_Changed" Unchecked="InfoItem_Changed"/>
                        <CheckBox x:Name="ChkDataLaudo"
                                  Content="Data do Laudo"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="InfoItem_Changed" Unchecked="InfoItem_Changed"/>
                        <CheckBox x:Name="ChkDataRegistro"
                                  Content="Data do Registro no SISAGUA"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="InfoItem_Changed" Unchecked="InfoItem_Changed"/>
                        <CheckBox x:Name="ChkCategoriaArea"
                                  Content="Categoria da Área"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="InfoItem_Changed" Unchecked="InfoItem_Changed"/>
                        <CheckBox x:Name="ChkPrecedencia"
                                  Content="Procedência da coleta"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="InfoItem_Changed" Unchecked="InfoItem_Changed"/>
                        <CheckBox x:Name="ChkPontoColeta"
                                  Content="Ponto de coleta"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="InfoItem_Changed" Unchecked="InfoItem_Changed"/>
                        <CheckBox x:Name="ChkArea"
                                  Content="Área"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="InfoItem_Changed" Unchecked="InfoItem_Changed"/>
                        <CheckBox x:Name="ChkLocal"
                                  Content="Local"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="InfoItem_Changed" Unchecked="InfoItem_Changed"/>
                        <CheckBox x:Name="ChkDescricaoLocal"
                                  Content="Descrição do local (Endereço)"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="InfoItem_Changed" Unchecked="InfoItem_Changed"/>
                        <CheckBox x:Name="ChkLatLong"
                                  Content="Latitude e Longitude"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="InfoItem_Changed" Unchecked="InfoItem_Changed"/>
                        <CheckBox x:Name="ChkHoraColeta"
                                  Content="Hora da coleta"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="InfoItem_Changed" Unchecked="InfoItem_Changed"/>
                        <CheckBox x:Name="ChkChuva"
                                  Content="Ocorrência de chuva em 48h antes da coleta"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="InfoItem_Changed" Unchecked="InfoItem_Changed"/>
                    </WrapPanel>
                </StackPanel>

                <Separator Background="#2a2a2a" Margin="0,0,0,24"/>

                <!-- Resultado — Parâmetros básicos -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="Resultado &#x2014; Parâmetros básicos"
                               FontSize="14" FontWeight="SemiBold" Foreground="#e5e7e6"
                               Margin="0,0,0,12"/>
                    <CheckBox x:Name="ChkBasicosTodos"
                              Content="Todos"
                              Foreground="#e5e7e6" FontSize="13" FontWeight="SemiBold"
                              Margin="0,0,0,10"
                              Checked="ChkBasicosTodos_Checked"
                              Unchecked="ChkBasicosTodos_Unchecked"/>
                    <WrapPanel>
                        <CheckBox x:Name="ChkColiformes"
                                  Content="Coliformes totais e E.coli"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="BasicosItem_Changed" Unchecked="BasicosItem_Changed"/>
                        <CheckBox x:Name="ChkFluoreto"
                                  Content="Fluoreto (mg/L)"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="BasicosItem_Changed" Unchecked="BasicosItem_Changed"/>
                        <CheckBox x:Name="ChkTurbidez"
                                  Content="Turbidez (uT)"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="BasicosItem_Changed" Unchecked="BasicosItem_Changed"/>
                        <CheckBox x:Name="ChkPh"
                                  Content="pH"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="BasicosItem_Changed" Unchecked="BasicosItem_Changed"/>
                        <CheckBox x:Name="ChkCorAparente"
                                  Content="Cor Aparente (uH)"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="BasicosItem_Changed" Unchecked="BasicosItem_Changed"/>
                        <CheckBox x:Name="ChkDioxidoCloro"
                                  Content="Dióxido de Cloro (mg/L)"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="BasicosItem_Changed" Unchecked="BasicosItem_Changed"/>
                        <CheckBox x:Name="ChkCloroLivre"
                                  Content="Cloro Residual Livre (mg/L)"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="BasicosItem_Changed" Unchecked="BasicosItem_Changed"/>
                        <CheckBox x:Name="ChkCloroCombinado"
                                  Content="Cloro Residual Combinado (mg/L)"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="BasicosItem_Changed" Unchecked="BasicosItem_Changed"/>
                    </WrapPanel>
                </StackPanel>

                <Separator Background="#2a2a2a" Margin="0,0,0,24"/>

                <!-- Resultado — Demais parâmetros -->
                <StackPanel Margin="0,0,0,32">
                    <TextBlock Text="Resultado &#x2014; Demais parâmetros"
                               FontSize="14" FontWeight="SemiBold" Foreground="#e5e7e6"
                               Margin="0,0,0,12"/>
                    <CheckBox x:Name="ChkDemaisTodos"
                              Content="Todos"
                              Foreground="#e5e7e6" FontSize="13" FontWeight="SemiBold"
                              Margin="0,0,0,10"
                              Checked="ChkDemaisTodos_Checked"
                              Unchecked="ChkDemaisTodos_Unchecked"/>
                    <WrapPanel Margin="0,0,0,8">
                        <CheckBox x:Name="ChkAgrotoxicos"
                                  Content="Agrotóxicos"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="DemaisItem_Changed" Unchecked="DemaisItem_Changed"/>
                        <CheckBox x:Name="ChkSubstanciasOrganicas"
                                  Content="Substâncias Orgânicas"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="DemaisItem_Changed" Unchecked="DemaisItem_Changed"/>
                        <CheckBox x:Name="ChkCianobacterias"
                                  Content="Cianobactérias"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="DemaisItem_Changed" Unchecked="DemaisItem_Changed"/>
                        <CheckBox x:Name="ChkProdutosSecundarios"
                                  Content="Produtos secundários da desinfecção"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="DemaisItem_Changed" Unchecked="DemaisItem_Changed"/>
                        <CheckBox x:Name="ChkCianotoxinas"
                                  Content="Cianotoxinas"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="DemaisItem_Changed" Unchecked="DemaisItem_Changed"/>
                        <CheckBox x:Name="ChkRadioatividade"
                                  Content="Radioatividade"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="DemaisItem_Changed" Unchecked="DemaisItem_Changed"/>
                        <CheckBox x:Name="ChkSubstanciasInorganicas"
                                  Content="Substâncias Inorgânicas"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="DemaisItem_Changed" Unchecked="DemaisItem_Changed"/>
                        <CheckBox x:Name="ChkParamOrganoleticos"
                                  Content="Parâmetros Organolépticos"
                                  Foreground="#e5e7e6" FontSize="13" Margin="0,0,20,8"
                                  Checked="DemaisItem_Changed" Unchecked="DemaisItem_Changed"/>
                    </WrapPanel>
                    <CheckBox x:Name="ChkOutros"
                              Content="Outros"
                              Foreground="#e5e7e6" FontSize="13" Margin="0,0,0,0"
                              Checked="DemaisItem_Changed" Unchecked="DemaisItem_Changed"/>
                </StackPanel>

                <!-- Ação -->
                <Button x:Name="BtnStart"
                        Content="Iniciar Processo"
                        HorizontalAlignment="Left"
                        Style="{StaticResource SidebarButton}"
                        Padding="16,8"
                        Margin="0,0,0,16"
                        Click="BtnStart_Click"/>

                <TextBlock x:Name="TxtStatus"
                           Foreground="#666666"
                           FontSize="12"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</views:BaseView>
